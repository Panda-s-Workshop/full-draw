            "model": "fulldraw:item/longbow_pulling_1"
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:model",
            "model": "fulldraw:item/longbow_pulling_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "fulldraw:item/longbow_pulling_0"
      }
    }
  }
}
