{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/Panda-s-Workshop/full-draw",
    "sources": "https://github.com/Panda-s-Workshop/full-draw",
    "issues": "https://github.com/Panda-s-Workshop/full-draw/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.panda.fulldraw.fabric.FullDrawFabric"
    ],
    "client": [
      "com.panda.fulldraw.fabric.client.FullDrawFabricClient"
    ]
  },
  "accessWidener": "fulldraw.accesswidener",
  "mixins": [
    "fulldraw.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
